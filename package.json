{
  "name": "vraxia-work",
  "version": "0.1.0",
  "description": "Open AI platform for job seekers — apply to hundreds of jobs with AI agents at near-zero cost",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "hunt": "npm run hunt -w apps/cli",
    "recover": "npm run recover -w apps/cli",
    "recover:dry": "npm run recover:dry -w apps/cli",
    "diagnostico": "npm run diagnostico -w apps/cli",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint packages apps --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SAMIRRICARDO/vraxia-work.git"
  },
  "keywords": [
    "ai-agents",
    "job-search",
    "automation",
    "anthropic",
    "claude",
    "typescript",
    "playwright"
  ],
  "author": "Samir Ricardo",
  "license": "MIT"
}
