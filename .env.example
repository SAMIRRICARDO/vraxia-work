# Anthropic API Key (required)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (optional — defaults shown)
CLAUDE_DEFAULT_MODEL=claude-haiku-4-5-20251001
CLAUDE_POWERFUL_MODEL=claude-sonnet-4-6

# LinkedIn credentials (required for hunt command)
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cost guard (optional — in USD, monthly limit)
ANTHROPIC_MONTHLY_BUDGET=5.00

# Interview probability threshold for applying (0-100)
HIRE_THRESHOLD=50

# Resume path (used by recover command)
RESUME_PATH=./resume.pdf

# Max concurrent applications per session
MAX_CONCURRENT_APPS=3

# Database path (SQLite)
DB_PATH=.vraxia-work/vraxia.db

# QA cache path
QA_CACHE_PATH=.vraxia-work/qa-cache.json

# Log level: debug | info | warn | error
LOG_LEVEL=info
